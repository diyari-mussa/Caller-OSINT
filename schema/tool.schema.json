{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caller-osint.local/schema/tool.schema.json",
  "title": "Caller OSINT tool",
  "description": "One caller-ID or reverse-phone app in the Caller OSINT catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "play_store_name",
    "installed_name",
    "play_store_url",
    "developer_name",
    "platforms",
    "store",
    "ads",
    "price_model",
    "listing_status",
    "snapshot_date",
    "category",
    "inputs",
    "outputs",
    "lookup_mode",
    "lookup_status",
    "account_required",
    "registration",
    "premium_required_for_search",
    "contacts_upload",
    "call_recording",
    "community_feedback",
    "status",
    "source",
    "similar_to"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "description": "Android application id. Also the record id."
    },
    "play_store_name": { "type": "string", "minLength": 1 },
    "installed_name": { "type": "string", "minLength": 1 },
    "play_store_url": { "type": "string", "minLength": 1 },
    "developer_name": { "type": "string", "minLength": 1 },
    "developer_notes": { "type": "string" },
    "official_website": { "type": "string" },
    "icon_url": { "type": "string" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["android", "ios", "web"] }
    },
    "store": {
      "enum": ["google_play", "app_store", "web", "other_android_store"]
    },
    "also_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform"],
        "properties": {
          "platform": { "enum": ["android", "ios", "web"] },
          "package_id": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "installs_text": { "type": "string" },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "ratings_count": { "type": "integer", "minimum": 0 },
    "ads": { "enum": ["none", "present", "intrusive", "unknown"] },
    "price_model": { "enum": ["free", "freemium", "paid", "unknown"] },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "listing_status": { "enum": ["available", "removed", "unknown"] },
    "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "category": {
      "enum": ["caller_id", "reverse_lookup", "spam_reputation", "hybrid"]
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["phone_number", "person_name", "email", "username"]
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "caller_name",
          "spam_score",
          "spam_category",
          "carrier",
          "line_type",
          "country",
          "locality",
          "profile_photo",
          "email",
          "social_profile",
          "address",
          "business_name",
          "community_reports",
          "tags_or_comments"
        ]
      }
    },
    "lookup_mode": {
      "enum": ["manual_search", "incoming_call_only", "both", "none", "unknown"]
    },
    "lookup_status": {
      "enum": ["works", "no_reverse_lookup", "broken", "fake_or_random", "untested"]
    },
    "coverage_notes": { "type": "string" },
    "account_required": { "enum": ["none", "optional", "required", "unknown"] },
    "registration": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "phone_sms",
          "phone_unverified",
          "email",
          "google",
          "facebook",
          "username"
        ]
      }
    },
    "registration_raw": { "type": "string" },
    "premium_required_for_search": { "enum": ["yes", "no", "unknown"] },
    "contacts_upload": {
      "enum": ["required", "optional", "not_required", "unknown"]
    },
    "call_recording": { "enum": ["yes", "no", "unknown"] },
    "community_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "summary"],
        "properties": {
          "source": {
            "enum": ["google_play", "reddit", "blog", "investigator", "other"]
          },
          "url": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "osint_notes": { "type": "string" },
    "outputs_confidence": { "enum": ["tested", "inferred"] },
    "privacy_policy_url": { "type": "string" },
    "status": { "enum": ["proposed", "approved", "rejected"] },
    "source": { "enum": ["manual_spreadsheet", "discovery"] },
    "proposed_because": { "type": "string" },
    "similar_to": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
